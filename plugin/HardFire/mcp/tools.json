  {
    "name": "hardfire_wait_for",
    "description": "Wait for one browser condition with a bounded timeout. Persistent WebSockets and SSE do not block HTTP idle.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "condition": {
          "oneOf": [
