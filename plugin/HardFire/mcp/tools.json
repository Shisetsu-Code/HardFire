              },
              "required": [
                "type",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "url"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "type",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "load"
                },
                "value": {
                  "type": "string",
                  "enum": [
                    "interactive",
                    "complete"
                  ]
                }
              },
              "required": [
                "type",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "network_idle"
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        },
        "timeout_ms": {
          "default": 10000,
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "idle_ms": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "tab_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "condition"
